#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
HOST="${HOST:-127.0.0.1}"
PORT="${PORT:-8000}"
WORKERS="${PHP_CLI_SERVER_WORKERS:-4}"

cd "${ROOT}/public"

export PHP_CLI_SERVER_WORKERS="${WORKERS}"

exec php \
    -d upload_max_filesize=64M \
    -d post_max_size=80M \
    -d max_execution_time=120 \
    -d max_input_time=120 \
    -d memory_limit=512M \
    -S "${HOST}:${PORT}" \
    "${ROOT}/vendor/laravel/framework/src/Illuminate/Foundation/resources/server.php"
