USE BDSIT;
GO

;WITH Ajustes AS (
    SELECT FolioAjuste, FolioAviso
    FROM siniestros.tbAjusteDetalleAgricola

    UNION ALL

    SELECT FolioAjuste, FolioAviso
    FROM siniestros.tbAjusteDetalleGanadero

    UNION ALL

    SELECT FolioAjuste, FolioAviso
    FROM siniestros.tbAjusteDetalleAgricolaCat

    UNION ALL

    SELECT FolioAjuste, FolioAviso
    FROM siniestros.tbAjusteDetalleAgricolaCatMulti
),
Operaciones AS (
    SELECT DISTINCT
        S.IDSolicitante,
        P.NoPoliza,
        D.FolioDictamen
    FROM ele.tbSolicitantes AS S
    INNER JOIN pol.tbSolicitudes AS SOL
        ON SOL.IDSolicitante = S.IDSolicitante
    INNER JOIN pol.tbPolizas AS P
        ON P.IDSolicitud = SOL.IDSolicitud
    INNER JOIN siniestros.tbAvisos AS A
        ON A.Poliza = P.NoPoliza
    INNER JOIN Ajustes AS AJ
        ON AJ.FolioAviso = A.FolioAviso
    INNER JOIN siniestros.tbDictamen AS D
        ON D.FolioAjuste = AJ.FolioAjuste
),
DictamenesUnicos AS (
    SELECT FolioDictamen
    FROM Operaciones
    GROUP BY FolioDictamen
    HAVING COUNT(*) = 1
),
EntradasPorPoliza AS (
    SELECT
        O.IDSolicitante,
        O.NoPoliza,
        COUNT(DISTINCT O.FolioDictamen)
            AS num_operaciones_entrada
    FROM Operaciones AS O
    INNER JOIN DictamenesUnicos AS DU
        ON DU.FolioDictamen = O.FolioDictamen
    GROUP BY
        O.IDSolicitante,
        O.NoPoliza
)
SELECT
    P.NoPoliza AS no_poliza,
    S.NCliente AS no_cliente,
    LTRIM(RTRIM(CONCAT(
        S.Nombre, ' ',
        S.APaterno, ' ',
        S.AMaterno
    ))) AS nombre_cliente,

    CASE
        WHEN NULLIF(LTRIM(RTRIM(S.CURP)), '') IS NOT NULL
            THEN 'Persona Física'
        WHEN LEN(LTRIM(RTRIM(ISNULL(S.RFC, '')))) = 12
            THEN 'Persona Moral'
        WHEN LEN(LTRIM(RTRIM(ISNULL(S.RFC, '')))) = 13
            THEN 'Persona Física'
        ELSE NULL
    END AS tipo_persona,

    S.RFC AS rfc,
    S.CURP AS curp,
    S.PNacimiento AS fecha_nacimiento,

    CAST(NULL AS DATE) AS fecha_constitucion,
    CAST(NULL AS DATE) AS fecha_primera_relacion,
    CAST(NULL AS INT) AS edad,
    CAST(NULL AS INT) AS antiguedad_empresa_anios,
    CAST(NULL AS INT) AS antiguedad_relacion_anios,

    S.OcupGiro AS ocupacion_giro,
    CAST(NULL AS VARCHAR(150)) AS estado,
    S.Nacionalidad AS pais_nacionalidad,
    CAST('México' AS VARCHAR(100)) AS pais_operacion,
    CAST('Sin coincidencia en listas' AS VARCHAR(150))
        AS categoria_pld,
    CAST('Interno' AS VARCHAR(50)) AS canal,

    CASE
        WHEN ISNULL(S.ckAgente, 0) = 0
            THEN '0-Agente Directo'
        ELSE CAST(S.NAgente AS VARCHAR(100))
    END AS agente,

    CAST(NULL AS VARCHAR(100)) AS ramo,
    CAST(NULL AS VARCHAR(150)) AS producto,
    CAST(NULL AS VARCHAR(150)) AS grupo_producto,
    CAST(NULL AS DECIMAL(18, 2)) AS prima_total,
    CAST(NULL AS VARCHAR(10)) AS moneda,
    CAST(NULL AS DECIMAL(18, 6)) AS tipo_cambio,
    CAST(NULL AS DATE) AS fecha_emision,

    ISNULL(EP.num_operaciones_entrada, 0)
        AS num_operaciones_entrada

FROM ele.tbSolicitantes AS S
INNER JOIN pol.tbSolicitudes AS SOL
    ON SOL.IDSolicitante = S.IDSolicitante
INNER JOIN pol.tbPolizas AS P
    ON P.IDSolicitud = SOL.IDSolicitud
LEFT JOIN EntradasPorPoliza AS EP
    ON EP.IDSolicitante = S.IDSolicitante
    AND EP.NoPoliza = P.NoPoliza
ORDER BY
    S.NCliente,
    P.NoPoliza;
